# Multi-stage Dockerfile for QueryLens React Frontend
FROM node:20-alpine AS builder

WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Stage 2: Nginx Web Server
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY QueryLens.jpg /usr/share/nginx/html/QueryLens.jpg

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
